{
	"schemaVersion": 1,
	"id": "politicalserver",
	"version": "1.0.0",
	"name": "Political Server",
	"description": "Server-side political and economic mod: weekly elections and perks, settlements, markets, guilds and wars.",
	"authors": ["GL-327"],
	"contact": {
		"homepage": "https://github.com/GL-327/Economical-and-Political-Mod",
		"sources": "https://github.com/GL-327/Economical-and-Political-Mod",
		"issues": "https://github.com/GL-327/Economical-and-Political-Mod/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/politicalserver/icon.png",
	"environment": "server",
	"custom": {
		"fabric:registry_sync": {
			"skip": true
		},
		"fabric-api:server-side-only": true
	},
	"entrypoints": {
		"server": ["com.political.PoliticalServer"]
	},
	"mixins": ["political.mixins.json", "politicalserver.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.165.0"
	}
}